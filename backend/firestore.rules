rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chỉ cho phép chủ sở hữu đã đăng nhập được đọc/ghi dữ liệu của chính họ
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Các khu nhà / dãy trọ / ki-ốt
    match /properties/{propertyId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.ownerId == request.auth.uid)
                         && (request.resource == null || request.resource.data.ownerId == request.auth.uid);
    }

    // Phòng trọ / Ki-ốt
    match /rooms/{roomId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.ownerId == request.auth.uid)
                         && (request.resource == null || request.resource.data.ownerId == request.auth.uid);
    }

    // Khách thuê
    match /tenants/{tenantId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.ownerId == request.auth.uid)
                         && (request.resource == null || request.resource.data.ownerId == request.auth.uid);
    }

    // Lịch sử ghi chỉ số điện nước hàng tháng
    match /meter_readings/{readingId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.ownerId == request.auth.uid)
                         && (request.resource == null || request.resource.data.ownerId == request.auth.uid);
    }

    // Hóa đơn hàng tháng
    match /invoices/{invoiceId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.ownerId == request.auth.uid)
                         && (request.resource == null || request.resource.data.ownerId == request.auth.uid);
    }
  }
}
